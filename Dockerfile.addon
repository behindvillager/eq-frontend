ARG BUILD_FROM
FROM ${BUILD_FROM}

# Install requirements for building
RUN apk add --no-cache \
    nodejs \
    npm \
    git \
    python3 \
    make \
    g++

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies
RUN npm install -g yarn && yarn install --frozen-lockfile

# Copy source code
COPY . .

# Build the frontend
RUN yarn run build

# Setup runtime
FROM ${BUILD_FROM}

RUN apk add --no-cache \
    nodejs \
    nginx

WORKDIR /app

# Copy built frontend
COPY --from=0 /app/hassio/build /usr/share/nginx/html

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Expose port
EXPOSE 8099

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
