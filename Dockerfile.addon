ARG BUILD_FROM=ghcr.io/home-assistant/aarch64-base:3.20
FROM node:20-alpine AS builder

WORKDIR /build

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies
RUN apk add --no-cache python3 make g++ git && \
    corepack enable && \
    yarn install --frozen-lockfile --production=false

# Copy source
COPY . .

# Build hassio frontend
RUN yarn run build

# Runtime image
FROM ${BUILD_FROM}

RUN apk add --no-cache nginx

# Copy built frontend
COPY --from=builder /build/hassio/build /usr/share/nginx/html

# Copy nginx config
RUN mkdir -p /etc/nginx/http.d && \
    echo 'server {' > /etc/nginx/http.d/default.conf && \
    echo '    listen 8099;' >> /etc/nginx/http.d/default.conf && \
    echo '    root /usr/share/nginx/html;' >> /etc/nginx/http.d/default.conf && \
    echo '    index index.html;' >> /etc/nginx/http.d/default.conf && \
    echo '    location / {' >> /etc/nginx/http.d/default.conf && \
    echo '        try_files $uri $uri/ /index.html;' >> /etc/nginx/http.d/default.conf && \
    echo '    }' >> /etc/nginx/http.d/default.conf && \
    echo '}' >> /etc/nginx/http.d/default.conf

EXPOSE 8099

CMD ["nginx", "-g", "daemon off;"]
